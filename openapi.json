{
  "openapi": "3.1.0",
  "info": {
    "title": "Coins Agent Check",
    "version": "0.2.0",
    "contact": {
      "name": "Coins Agent Check",
      "url": "https://coins.zhidun.ai"
    },
    "x-guidance": "Offered only to actual customers outside mainland China where lawful, subject to sanctions; an Agent hosting location does not determine customer eligibility. Read /privacy.html and /SKILL.md. Use costPreflight for free calculations from your own assumptions. For BSC receipt reconciliation, inspect x402 terms and authorize only 0.02 Base USDC under your own spending policy. Keep the random Idempotency-Key, exact body and original authorization private for retries. Never create a second payment to repair an unresolved one. No private keys or wallet sessions are accepted.",
    "description": "Preflight uses caller assumptions. Paid BSC receipt analysis uses one RPC, checks canonical block and at least 12 confirmations; no tracing, price feed or contract audit. Payments are 0.02 USDC on Base, not BSC."
  },
  "servers": [
    {
      "url": "https://coins.zhidun.ai"
    }
  ],
  "paths": {
    "/v1/preflight": {
      "post": {
        "operationId": "costPreflight",
        "summary": "Free exact-decimal cost and quote-age check",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "notionalUsd": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,18})?$"
                  },
                  "grossEdgeBps": {
                    "type": "string",
                    "pattern": "^-?[0-9]{1,4}(\\.[0-9]{1,8})?$"
                  },
                  "entryFeeBps": {
                    "type": "string",
                    "pattern": "^[0-9]{1,4}(\\.[0-9]{1,8})?$"
                  },
                  "exitFeeBps": {
                    "type": "string",
                    "pattern": "^[0-9]{1,4}(\\.[0-9]{1,8})?$"
                  },
                  "entrySlippageBps": {
                    "type": "string",
                    "pattern": "^[0-9]{1,4}(\\.[0-9]{1,8})?$"
                  },
                  "exitSlippageBps": {
                    "type": "string",
                    "pattern": "^[0-9]{1,4}(\\.[0-9]{1,8})?$"
                  },
                  "gasUsd": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,18})?$"
                  },
                  "otherCostUsd": {
                    "type": "string",
                    "pattern": "^(0|[1-9][0-9]{0,11})(\\.[0-9]{1,18})?$"
                  },
                  "quoteAt": {
                    "type": "string",
                    "format": "date-time",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
                  },
                  "maxQuoteAgeSeconds": {
                    "default": 60,
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 3600
                  }
                },
                "required": [
                  "notionalUsd",
                  "grossEdgeBps",
                  "entryFeeBps",
                  "exitFeeBps",
                  "entrySlippageBps",
                  "exitSlippageBps",
                  "gasUsd",
                  "otherCostUsd",
                  "quoteAt"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Calculation using caller assumptions"
          },
          "400": {
            "description": "Invalid input"
          },
          "429": {
            "description": "Rate limited"
          }
        }
      }
    },
    "/v1/bsc/reconcile": {
      "post": {
        "operationId": "reconcileBscReceipt",
        "summary": "Paid receipt gas, ERC-20 net flow and expected-transfer checks",
        "x-payment-info": {
          "protocols": [
            {
              "x402": {
                "x402Version": 2,
                "scheme": "exact",
                "network": "eip155:8453",
                "asset": "0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913",
                "amount": "20000"
              }
            }
          ],
          "price": {
            "mode": "fixed",
            "currency": "USD",
            "amount": "0.02"
          },
          "note": "Paid in exactly 0.02 USDC on Base; runtime PAYMENT-REQUIRED is authoritative."
        },
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 24,
              "maxLength": 128
            },
            "description": "Random private retrieval key. Preserve with the exact body and signed payment across retries."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "chainId": {
                    "type": "number",
                    "const": 56
                  },
                  "txHash": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{64}$"
                  },
                  "account": {
                    "type": "string",
                    "pattern": "^0x[0-9a-fA-F]{40}$"
                  },
                  "expected": {
                    "default": [],
                    "maxItems": 10,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string",
                          "pattern": "^0x[0-9a-fA-F]{40}$"
                        },
                        "minimumNetReceivedRaw": {
                          "type": "string",
                          "pattern": "^(0|[1-9][0-9]{0,77})$"
                        }
                      },
                      "required": [
                        "token",
                        "minimumNetReceivedRaw"
                      ],
                      "additionalProperties": false
                    }
                  }
                },
                "required": [
                  "chainId",
                  "txHash",
                  "account"
                ],
                "additionalProperties": false
              },
              "example": {
                "chainId": 56,
                "txHash": "0x1111111111111111111111111111111111111111111111111111111111111111",
                "account": "0x2222222222222222222222222222222222222222",
                "expected": []
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Delivered report and PAYMENT-RESPONSE; repeated identical requests retrieve the same report"
          },
          "400": {
            "description": "Invalid input; no settlement"
          },
          "402": {
            "description": "x402 v2 PAYMENT-REQUIRED header; use a compatible buyer wallet with Base USDC"
          },
          "409": {
            "description": "Request or payment is bound elsewhere/in progress; no new payment"
          },
          "425": {
            "description": "Transaction unknown/pending, reorganized or below confirmation threshold; no settlement"
          },
          "428": {
            "description": "Private random Idempotency-Key required before submitting a payment"
          },
          "429": {
            "description": "Rate limited"
          },
          "502": {
            "description": "Upstream evidence unavailable or inconsistent; no settlement"
          },
          "503": {
            "description": "Payment or service unavailable/unresolved; preserve payment and retry identically"
          }
        }
      }
    }
  }
}
